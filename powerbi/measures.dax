// ════════════════════════════════════════════════════════════════════
// مقاييس DAX جاهزة — لوحة التنبؤ بنتيجة طلب الموافقة المسبقة
// منصّة سديد · تجمع مكة المكرمة الصحي · إدارة أداء تنمية الإيرادات
//
// تفترض وجود جدول اسمه Authorizations ناتج عن powerbi/powerbi_script.py
// (سمِّ الجدول بهذا الاسم عند الاستيراد، أو بدّل الاسم في المقاييس أدناه)
// ════════════════════════════════════════════════════════════════════

// ── 1. رابط صفحة التنبؤ للطلب المحدّد ────────────────────────────────
// اعرضه في مرئي «HTML Content» داخل <iframe>، أو كزرّ Web URL.
// استبدل BaseUrl بعنوان نشر الصفحة لديك.
رابط التنبؤ =
VAR BaseUrl = "https://<حسابك>.github.io/RCM/predict.html"
VAR Q =
    "?embed=1&auto=1"
    & "&total="        & FORMAT( COALESCE( SELECTEDVALUE( Authorizations[Total] ), 0 ), "0.##" )
    & "&visitType="    & SELECTEDVALUE( Authorizations[Visit Type Key] )
    & "&hospital="     & SELECTEDVALUE( Authorizations[Hospital Key] )
    & "&clinic="       & SELECTEDVALUE( Authorizations[Clinic Key] )
    & "&contract="     & SELECTEDVALUE( Authorizations[Contract Key] )
    & "&nphies="       & SELECTEDVALUE( Authorizations[Nphies Key] )
    & "&nationality="  & SELECTEDVALUE( Authorizations[Nationality Key] )
    & "&patientClass=" & SELECTEDVALUE( Authorizations[Patient Class Key] )
    & "&icd="          & SELECTEDVALUE( Authorizations[Icd 10] )
    & "&triage="       & FORMAT( COALESCE( SELECTEDVALUE( Authorizations[Triage Num] ), 3 ), "0" )
    & "&gender="       & SELECTEDVALUE( Authorizations[Gender] )
RETURN
    BaseUrl & Q

// ── 2. نفس الرابط داخل iframe لمرئي HTML Content ───────────────────
مرئي التنبؤ HTML =
"<iframe src=""" & [رابط التنبؤ] & """ width=""100%"" height=""880"" frameborder=""0""></iframe>"

// ── 3. مؤشّرات الأداء الرئيسية ──────────────────────────────────────
عدد الطلبات = COUNTROWS( Authorizations )

المبلغ المعرّض للخطر = SUM( Authorizations[amount_at_risk] )

الإيراد المتوقّع = SUM( Authorizations[expected_revenue] )

نسبة المعرّض للخطر =
DIVIDE( [المبلغ المعرّض للخطر], SUM( Authorizations[billed_amount] ) )

طلبات عالية الخطر =
CALCULATE( COUNTROWS( Authorizations ), Authorizations[risk_band] = "خطر مرتفع" )

نسبة عالية الخطر =
DIVIDE( [طلبات عالية الخطر], [عدد الطلبات] )

متوسّط خطر عدم التحصيل = AVERAGE( Authorizations[p_not_fully_approved] )

// ── 4. دقّة النموذج على الطلبات التي صدر فيها قرار فعلي ────────────
// الهدف ثنائي: تُقارن «موافقة كاملة» بحالة Approved، وكل ما عداها
// (Rejected أو Partially Approved) يقابل «موافقة غير كاملة».
دقّة النموذج =
VAR Decided =
    FILTER( Authorizations, Authorizations[Approval Status] IN { "Approved", "Partially Approved", "Rejected" } )
VAR Hits =
    COUNTROWS(
        FILTER(
            Decided,
            ( Authorizations[pred_label] = "Approved" && Authorizations[Approval Status] = "Approved" )
                || ( Authorizations[pred_label] = "NotFullyApproved"
                     && Authorizations[Approval Status] <> "Approved" )
        )
    )
RETURN
    DIVIDE( Hits, COUNTROWS( Decided ) )

// استرجاع الفئة الحرجة: نسبة الحالات الخاسرة فعلاً التي التقطها النموذج.
// هذا هو المؤشّر التشغيلي الأهم — أهم من الدقّة الإجمالية.
استرجاع الحالات الخاسرة =
VAR Lost = FILTER( Authorizations, Authorizations[Approval Status] IN { "Rejected", "Partially Approved" } )
VAR Caught = COUNTROWS( FILTER( Lost, Authorizations[pred_label] = "NotFullyApproved" ) )
RETURN
    DIVIDE( Caught, COUNTROWS( Lost ) )

// ── 5. المبلغ القابل للاسترداد بالتدخّل المسبق ─────────────────────
// تقدير الأثر: الطلبات عالية الخطر التي لم يصدر فيها قرار بعد،
// أي النافذة الزمنية التي ما زال بالإمكان التدخّل فيها.
فرصة التدخّل =
CALCULATE(
    SUM( Authorizations[amount_at_risk] ),
    Authorizations[risk_band] = "خطر مرتفع",
    NOT Authorizations[Approval Status] IN { "Approved", "Partially Approved", "Rejected" }
)

// ── 6. تنسيق شرطي لشريحة الخطر ─────────────────────────────────────
// اربطه بخاصية Background color للجدول: Format ← Conditional formatting ← Field value
لون الخطر =
SWITCH(
    SELECTEDVALUE( Authorizations[risk_band] ),
    "خطر مرتفع",  "#F87171",
    "خطر متوسّط", "#FBBF24",
    "#22D3A0"
)
