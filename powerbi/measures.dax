// ════════════════════════════════════════════════════════════════════
// مقاييس DAX جاهزة — لوحة التنبؤ بالموافقة التأمينية
// تجمع مكة الصحي · إدارة الدورة الإيرادية وتحليل البيانات
//
// تفترض وجود جدول اسمه Claims ناتج عن powerbi/powerbi_script.py
// ════════════════════════════════════════════════════════════════════

// ── 1. رابط صفحة التنبؤ للمطالبة المحدّدة ─────────────────────────────
// اعرضه في مرئي «HTML Content» داخل <iframe>، أو كزرّ Web URL.
// استبدل BaseUrl بعنوان نشر الصفحة لديك.
رابط التنبؤ =
VAR BaseUrl = "https://<حسابك>.github.io/RCM/predict.html"
VAR Q =
    "?embed=1&auto=1"
    & "&total="        & FORMAT( COALESCE( SELECTEDVALUE( Claims[Total] ), 0 ), "0.##" )
    & "&visitType="    & SELECTEDVALUE( Claims[Visit Type Key] )
    & "&hospital="     & SELECTEDVALUE( Claims[Hospital Key] )
    & "&clinic="       & SELECTEDVALUE( Claims[Clinic Key] )
    & "&contract="     & SELECTEDVALUE( Claims[Contract Key] )
    & "&billStatus="   & SELECTEDVALUE( Claims[Bill Status Key] )
    & "&nphies="       & SELECTEDVALUE( Claims[Nphies Key] )
    & "&nationality="  & SELECTEDVALUE( Claims[Nationality Key] )
    & "&patientClass=" & SELECTEDVALUE( Claims[Patient Class Key] )
    & "&icd="          & SELECTEDVALUE( Claims[Icd 10] )
    & "&triage="       & FORMAT( COALESCE( SELECTEDVALUE( Claims[Triage Num] ), 3 ), "0" )
    & "&gender="       & SELECTEDVALUE( Claims[Gender] )
RETURN
    BaseUrl & Q

// ── 2. نفس الرابط داخل iframe لمرئي HTML Content ───────────────────
مرئي التنبؤ HTML =
"<iframe src=""" & [رابط التنبؤ] & """ width=""100%"" height=""880"" frameborder=""0""></iframe>"

// ── 3. مؤشّرات الأداء الرئيسية ──────────────────────────────────────
عدد المطالبات = COUNTROWS( Claims )

المبلغ المعرّض للخطر = SUM( Claims[amount_at_risk] )

الإيراد المتوقّع = SUM( Claims[expected_revenue] )

نسبة المعرّض للخطر =
DIVIDE( [المبلغ المعرّض للخطر], SUM( Claims[billed_amount] ) )

مطالبات عالية الخطر =
CALCULATE( COUNTROWS( Claims ), Claims[risk_band] = "خطر مرتفع" )

نسبة عالية الخطر =
DIVIDE( [مطالبات عالية الخطر], [عدد المطالبات] )

متوسّط احتمال الرفض = AVERAGE( Claims[p_rejected] )

// ── 4. دقّة النموذج على المطالبات التي صدر فيها قرار فعلي ──────────
// تُحسب فقط على الصفوف التي تحمل قراراً نهائياً، لا على المعلّقة.
دقّة النموذج =
VAR Decided =
    FILTER( Claims, Claims[Approval Status] IN { "Approved", "Partially Approved", "Rejected" } )
VAR Hits =
    COUNTROWS( FILTER( Decided, Claims[pred_label] = Claims[Approval Status] ) )
RETURN
    DIVIDE( Hits, COUNTROWS( Decided ) )

// ── 5. المبلغ القابل للاسترداد بالتدخّل المسبق ─────────────────────
// تقدير الأثر: المطالبات عالية الخطر التي لم يصدر فيها قرار بعد،
// أي النافذة الزمنية التي ما زال بالإمكان التدخّل فيها.
فرصة التدخّل =
CALCULATE(
    SUM( Claims[amount_at_risk] ),
    Claims[risk_band] = "خطر مرتفع",
    NOT Claims[Approval Status] IN { "Approved", "Partially Approved", "Rejected" }
)

// ── 6. تنسيق شرطي لشريحة الخطر ─────────────────────────────────────
// اربطه بخاصية Background color للجدول: Format ← Conditional formatting ← Field value
لون الخطر =
SWITCH(
    SELECTEDVALUE( Claims[risk_band] ),
    "خطر مرتفع",  "#F87171",
    "خطر متوسّط", "#FBBF24",
    "#22D3A0"
)
